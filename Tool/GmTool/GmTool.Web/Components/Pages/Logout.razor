@page "/logout"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject OperatorAuthService Auth
@inject NavigationManager Navigation

@* 로그인과 같은 이유로 정적 SSR이다(SignOutAsync도 응답 헤더를 써야 한다). *@

<PageTitle>로그아웃 · GmTool</PageTitle>

<p>로그아웃 중…</p>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null)
        {
            return;
        }

        // DB에 남아 있는 API 토큰도 함께 회수한다. 쿠키만 지우면 이미 발급된 API 토큰이
        // 만료 시각까지 그대로 살아 있어서, 로그아웃했는데 스크립트는 계속 동작하는
        // 상태가 된다.
        var idClaim = HttpContext.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (ulong.TryParse(idClaim, out var operatorId))
        {
            await Auth.LogoutAsync(operatorId, HttpContext.RequestAborted);
        }

        await HttpContext.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
