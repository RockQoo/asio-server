@inherits LayoutComponentBase
@inject GameCommandService Commands

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-end align-items-center gap-3">
            @* World 연결 상태를 항상 보이게 둔다 -- 우편/공지가 실패하는 가장 흔한 원인이
               "WorldServer가 안 떠 있음"이라, 명령을 보내기 전에 눈으로 확인할 수 있어야 한다. *@
            @if (Commands.IsWorldConnected)
            {
                <span class="badge text-bg-success">World 연결됨 (@Commands.WorldEndpoint)</span>
            }
            else
            {
                <span class="badge text-bg-danger" title="@Commands.WorldLastError">
                    World 연결 끊김 (@Commands.WorldEndpoint)
                </span>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    처리되지 않은 오류가 발생했습니다.
    <a href="." class="reload">새로고침</a>
    <span class="dismiss">🗙</span>
</div>
